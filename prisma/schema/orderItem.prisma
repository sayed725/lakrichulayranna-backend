model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  itemId    String
  itemName  String
  itemPrice Float
  quantity  Int
  total     Float
  item      Item   @relation(fields: [itemId], references: [id])
  order     Order  @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([itemId])
}
